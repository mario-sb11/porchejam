# Copia este archivo a .env.local para activar las cuentas en desarrollo.
# Sin estas variables la app funciona igual en modo invitado.

# Proyecto de Supabase (Settings → API). La clave publicable es pública por diseño:
# la seguridad la ponen las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://podrqpgvmtvkdehxvemw.supabase.co
