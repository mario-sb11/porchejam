# Copia este archivo a .env.local para activar las cuentas en desarrollo.
# Sin estas variables la app funciona igual en modo invitado.

# Proyecto de Supabase (Settings → API). La clave publicable es pública por diseño:
# la seguridad la ponen las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://podrqpgvmtvkdehxvemw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_N_fR7vJFIv7EW_wJ3jM9nA_5FZY-x-4

# Métodos de acceso activados, separados por comas: google, email (vacío = sin cuentas).
VITE_AUTH_PROVIDERS=

# Enlace de donaciones (Ko-fi, Buy Me a Coffee...). Vacío = no se muestra la sección de apoyo.
VITE_DONATION_URL=

# Arena Online (solo servidor, NUNCA con prefijo VITE_). En la base de datos se guarda su hash:
#   insert into arena_private.config values (true, sha256(convert_to('<secreto>', 'UTF8')));
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ARENA_SERVER_SECRET=
